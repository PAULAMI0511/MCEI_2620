   "source": [
    "comm = MPI.COMM_WORLD\n",
    "rank = comm.Get_rank()\n",
    "size = comm.Get_size()\n",
    "print(f\"Hola desde el proceso {rank} de un total de {size} procesos.\")\n",
    "if rank == 0:\n",
    "    print(\"Proceso maestro coordinando la tarea paralela.\")"
   ]
